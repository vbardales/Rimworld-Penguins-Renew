<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BigBirdThingBase">
    <defName>emperor_penguin</defName>
    <label>emperor penguin</label>
    <description>The emperor penguin (Aptenodytes forsteri) is the tallest and heaviest of all living penguin species and is endemic to Antarctica. How it end up in rimworld.  but nobody knows.</description>
    <statBases>
      <Wildness>0.15</Wildness>
      <MoveSpeed>4.1</MoveSpeed>
      <ComfyTemperatureMin>-65</ComfyTemperatureMin>
	  <ComfyTemperatureMax>15</ComfyTemperatureMax>
      <MarketValue>875</MarketValue>
    </statBases>
    <race>
	  <packAnimal>true</packAnimal>
      <herdAnimal>false</herdAnimal>
      <baseBodySize>1.35</baseBodySize>
      <baseHungerRate>0.25</baseHungerRate>
      <baseHealthScale>1.75</baseHealthScale>
      <foodType>CarnivoreAnimal</foodType>
	  <predator>true</predator>
	  <maxPreyBodySize>1.0</maxPreyBodySize>
      <trainability>Advanced</trainability>
      <lifeExpectancy>50</lifeExpectancy>
	  <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.45</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>1.50</minAge>
    	  <soundWounded>Pawn_Goose_Wounded</soundWounded>   
		  <soundDeath>Pawn_Goose_Death</soundDeath>
          <soundCall>Pawn_Goose_Call</soundCall>	
		  <soundAngry>Pawn_Goose_Angry</soundAngry>
        </li>
      </lifeStageAges>
	  <useMeatFrom>Cassowary</useMeatFrom>
      <leatherDef>Leather_Bird</leatherDef>
      <wildBiomes>
        <SeaIce>0.25</SeaIce>
        <IceSheet>0.15</IceSheet>
        <Tundra>0.05</Tundra>
        <BorealForest>0.02</BorealForest>
		<ColdBog>0.05</ColdBog>
      </wildBiomes>
      <manhunterOnTameFailChance>0.05</manhunterOnTameFailChance>
    </race>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggFertilizedDef>emperor_penguinFertilized</eggFertilizedDef>
        <eggUnfertilizedDef>emperor_penguinUnfertilized</eggUnfertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>20</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1</eggCountRange>
      </li>
	  
    </comps>
   <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.05</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>4</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>11</power>
        <cooldownTime>1.0</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>6</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

