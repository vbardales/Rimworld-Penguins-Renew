<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BigBirdThingBase">
    <defName>king_penguin</defName>
    <label>king penguin</label>
    <description>The king penguin (Aptenodytes patagonicus) is the second largest species of penguin.</description>
    <statBases>
      <Wildness>0.15</Wildness>
      <MoveSpeed>3.2</MoveSpeed>
      <ComfyTemperatureMin>-65</ComfyTemperatureMin>
	  <ComfyTemperatureMax>15</ComfyTemperatureMax>
      <MarketValue>260</MarketValue>
    </statBases>
    <race>
      <herdAnimal>true</herdAnimal>
      <baseBodySize>0.35</baseBodySize>
      <baseHungerRate>0.1</baseHungerRate>
      <baseHealthScale>0.9</baseHealthScale>
      <foodType>CarnivoreAnimal</foodType>
	  <nuzzleMtbHours>12</nuzzleMtbHours>
      <trainability>None</trainability>
      <lifeExpectancy>30</lifeExpectancy>
	  <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.45</minAge>
		  <soundWounded>Pawn_Duck_Wounded</soundWounded>   
		  <soundDeath>Pawn_Duck_Death</soundDeath>
          <soundCall>Pawn_Duck_Call</soundCall>	
		  <soundAngry>Pawn_Duck_Angry</soundAngry>
        </li>
      </lifeStageAges>
	  <useMeatFrom>Cassowary</useMeatFrom>
      <leatherDef>Leather_Bird</leatherDef>
      <wildBiomes>
        <SeaIce>0.55</SeaIce>
        <IceSheet>0.35</IceSheet>
        <Tundra>0.2</Tundra>
        <BorealForest>0.02</BorealForest>
		<ColdBog>0.05</ColdBog>
      </wildBiomes>
      <manhunterOnTameFailChance>0.0015</manhunterOnTameFailChance>
    </race>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggFertilizedDef>king_penguinFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>12</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1</eggCountRange>
      </li>
    </comps>
   <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>3</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>4</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>5</power>
        <cooldownTime>1.85</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>6</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>1</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <tradeTags>
      <li>AnimalCommon</li>
    </tradeTags>
